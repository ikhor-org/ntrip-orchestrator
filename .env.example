# =============================================================================
# grokbot environment template
# Copy to `.env` and fill secrets. NEVER commit `.env` or real secrets.
# =============================================================================

# --- Runtime mode ---
# local-dev (non-prod): NODE_ENV=development, ALLOW_FIXTURE_ORGS=true OK
# production:           NODE_ENV=production,  ALLOW_FIXTURE_ORGS=false (enforced in docker-compose.prod.yml)
NODE_ENV=development

API_PORT=8080
PROXY_PORT=2101
# Prod smoke: bind loopback so ports are not public (SSH tunnel instead of ufw 8080/2101)
# API_BIND=127.0.0.1
# PROXY_BIND=127.0.0.1

# Fixture orgs: local-dev only. Prod compose overlay forces false.
# App also refuses fixtures when NODE_ENV=production.
ALLOW_FIXTURE_ORGS=true

# Shared JSON store (api + proxy). In Docker this is /data/grokbot-store.json on a volume.
# Honest note: runtime is still JSON until a later Postgres adapter; PG is provisioned ready.
GROKBOT_STORE_PATH=/tmp/grokbot-m2-store.json

# --- Secrets (REQUIRED in any real deploy) ---
# Vault KEK: 32 bytes as 64-char hex OR base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LOCAL-DEV EXAMPLE ONLY — replace before any shared/staging/prod host:
VAULT_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Alias also accepted:
# VAULT_MASTER_KEY=

# Ops platform key (X-Ops-Key) for pilot intake / screening / activate / suspend.
# REQUIRED in production (docker-compose.prod.yml). Generate a long random string.
# LOCAL-DEV EXAMPLE ONLY:
OPS_API_KEY=local-dev-ops-key-change-me

# --- Postgres (schema/migrations; not yet used as runtime store) ---
POSTGRES_USER=grokbot
POSTGRES_PASSWORD=grokbot
POSTGRES_DB=grokbot
POSTGRES_PORT=5432
# Optional when applying migrations by hand:
# DATABASE_URL=postgres://grokbot:grokbot@127.0.0.1:5432/grokbot

# --- Optional env fallback upstream (local-dev; prefer vaulted secrets) ---
NTRIP_UPSTREAM_HOST=127.0.0.1
NTRIP_UPSTREAM_PORT=2101
NTRIP_UPSTREAM_MOUNTPOINT=TEST
NTRIP_UPSTREAM_USER=
NTRIP_UPSTREAM_PASS=
NTRIP_UPSTREAM_TLS=false

# CPOS adapter must remain disabled until counsel clears Kartverket ToS
CPOS_ADAPTER_ENABLED=false

# --- Optional mock NTRIP caster (compose profile mock-caster; Ops smoke) ---
# docker compose --profile mock-caster up -d mock-caster
# Vault host=mock-caster port=2102 — dummy creds only; never real vendor secrets in git.
MOCK_CASTER_MOUNT=MOCK
MOCK_CASTER_USER=mock
MOCK_CASTER_PASS=mock

