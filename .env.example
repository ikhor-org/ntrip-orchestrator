# M1 local only — no production secrets
NODE_ENV=development
API_PORT=8080
PROXY_PORT=2101

# Fixture orgs allowed only when true (non-prod)
ALLOW_FIXTURE_ORGS=true

# Shared JSON store so api + proxy share devices/vault in local multi-process runs
GROKBOT_STORE_PATH=/tmp/grokbot-m1-store.json

# Vault KEK: 32 bytes as 64-char hex OR base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Alias also accepted:
# VAULT_MASTER_KEY=

# Optional env fallback upstream (when no vaulted fixture secret yet).
# Prefer seeding via POST /v0/fixture/upstream-secret.
NTRIP_UPSTREAM_HOST=127.0.0.1
NTRIP_UPSTREAM_PORT=2101
NTRIP_UPSTREAM_MOUNTPOINT=TEST
NTRIP_UPSTREAM_USER=
NTRIP_UPSTREAM_PASS=
NTRIP_UPSTREAM_TLS=false

# CPOS adapter must remain disabled until counsel clears Kartverket ToS
CPOS_ADAPTER_ENABLED=false
